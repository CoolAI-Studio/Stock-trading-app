# --- Database ---
# Local dev default (SQLite, zero-config). For production point this at a cloud
# Postgres connection string, e.g. Neon: postgresql+psycopg2://user:pass@host/db?sslmode=require
DATABASE_URL=sqlite:///./trading_app_dev.db

# --- Auth ---
# The app REFUSES TO START if JWT_SECRET or TV_WEBHOOK_SECRET is empty or still
# one of the placeholder strings shipped in this repo -- both are public
# knowledge, so a deployment booting with them could be handed forged login
# tokens or fake webhook signals by anyone. Generate each with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
# Fernet key for encrypting stored secrets (notification tokens, broker credentials).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# --- TradingView webhook ---
TV_WEBHOOK_SECRET=change-me

# --- Web Push (browser notifications) ---
# Generate with: python scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- CORS ---
# Comma-separated list of allowed frontend origins. Add the deployed Vercel
# domain in production; localhost is fine for dev.
CORS_ORIGINS=http://localhost:5173

# --- AI setup assistant (pluggable provider, see services/ai_provider/) ---
# "openai_compatible" works with OpenRouter, NVIDIA NIM, or any OpenAI Chat
# Completions-compatible endpoint (many have free-tier models). "anthropic"
# uses the native Claude API and requires the optional `anthropic` package.
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
# Comma-separated, tried in order until one answers. More than one is strongly
# recommended on a free tier: OpenRouter's `:free` models run on donated
# upstream capacity shared by every OpenRouter user, so any single one returns
# 429 fairly often even when your own quota is untouched. A retired/renamed
# model (404) is stepped over the same way, so a stale name here is harmless.
# Do NOT use openrouter/auto -- it routes to paid models and bills their rate.
AI_MODEL=google/gemma-4-31b-it:free,openai/gpt-oss-20b:free,google/gemma-4-26b-a4b-it:free

# --- Market data polling ---
MARKET_DATA_POLL_INTERVAL_SEC=5

# --- Strategy execution ---
# Wall-clock seconds one strategy's on_tick() may take before it is abandoned
# and counted as a strategy error (5 consecutive errors deactivate it). Real
# strategies finish in microseconds; this only fires on an infinite loop or a
# hung network call. Keep it below MARKET_DATA_POLL_INTERVAL_SEC.
STRATEGY_TICK_TIMEOUT_SEC=2

# --- WebSocket ---
# TTL for the single-use ticket issued by POST /api/ws/ticket before a WS connect.
WS_TICKET_TTL_SECONDS=30

# --- Auth ---
# Keep false in production once your one user account exists; open it only long
# enough to self-register, or use scripts/create_user.py instead.
ALLOW_REGISTRATION=false

# Brute-force protection on POST /api/auth/login. After this many consecutive
# failures for one email, every further attempt gets 429 (the correct password
# included) until the lockout expires; a successful login clears the counter.
# Counters are in-process, so they reset when the service restarts.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# LOCAL DEVELOPMENT ONLY -- never set this in a deployment. It disables the
# startup guard described above so `uvicorn app.main:app` runs with the
# repo's placeholder JWT_SECRET/TV_WEBHOOK_SECRET. (The test suite is exempt
# automatically and needs no secrets configured at all.)
ALLOW_INSECURE_SECRETS=false

# --- Background worker ---
# Must run the app with --workers 1 when true -- two processes would each run
# their own polling loop and duplicate signals for the same tick.
WORKER_ENABLED=true
PENDING_ORDER_EXPIRY_MINUTES=180
NOTIFICATIONS_ENABLED=true

# --- Health probe (/healthz) ---
# /healthz returns 503 when the worker's last loop iteration, or its last poll
# cycle that completed, is older than HEALTH_MAX_AGE_SEC. Keep it far above
# MARKET_DATA_POLL_INTERVAL_SEC so one slow yfinance response never alerts --
# only a worker that is genuinely wedged or dead should.
HEALTH_MAX_AGE_SEC=300
# Grace period after process start during which "has not polled yet" reports as
# "starting" rather than failing. Render's free tier restarts the whole process
# after an idle spin-down, so every cold start legitimately begins here.
HEALTH_STARTUP_GRACE_SEC=120

# This deployment's own public address. Used to show the TradingView webhook
# URL on the notifications page; local development needs no change.
PUBLIC_BASE_URL=http://localhost:8000
