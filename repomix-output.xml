import tkinter as tk
from tkinter import messagebox

# 假設這些模組已經在 src 裡面實作好
from src.risk_control import RiskControl
from run_daily_backtest import run_daily_backtest

class TradingApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Trading System GUI")
        self.root.geometry("600x500")

        # API 設定區
        tk.Label(root, text="平台連接設定", font=("Arial", 14)).pack(pady=10)
        tk.Label(root, text="TradingView API Key").pack()
        self.tv_api = tk.Entry(root, width=40)
        self.tv_api.pack()
        tk.Label(root, text="富途牛牛 API Key").pack()
        self.futu_api = tk.Entry(root, width=40)
        self.futu_api.pack()

        # Line Bot 設定
        tk.Label(root, text="Line Bot Token").pack(pady=10)
        self.line_token = tk.Entry(root, width=40)
        self.line_token.pack()

        # 股票選擇
        tk.Label(root, text="股票代號").pack(pady=10)
        self.stock_entry = tk.Entry(root, width=20)
        self.stock_entry.pack()

        # 功能按鈕
        tk.Button(root, text="執行回測", command=self.run_backtest, width=25).pack(pady=5)
        tk.Button(root, text="檢查風險控制", command=self.check_risk, width=25).pack(pady=5)
        tk.Button(root, text="推送 Line Bot 通知", command=self.send_linebot, width=25).pack(pady=5)

        self.rc = RiskControl()

    def run_backtest(self):
        stock = self.stock_entry.get()
        results = run_daily_backtest("dummy.db")
        messagebox.showinfo("回測結果", f"股票: {stock}\n結果: {results}")

    def check_risk(self):
        stop_loss = self.rc.check_stop_loss(100, 85)
        take_profit = self.rc.check_take_profit(100, 110)
        pos_limit = self.rc.check_position_limit(30)
        messagebox.showinfo("風險控制", f"Stop Loss: {stop_loss}\nTake Profit: {take_profit}\nPosition Limit: {pos_limit}")

    def send_linebot(self):
        token = self.line_token.get()
        stock = self.stock_entry.get()
        messagebox.showinfo("Line Bot", f"已推送通知\nToken: {token}\n股票: {stock}")

def main():
    root = tk.Tk()
    app = TradingApp(root)
    root.mainloop()

if __name__ == "__main__":
    main()
